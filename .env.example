# ============================================================================
# SmartHire - Environment Configuration Template
# ============================================================================
# IMPORTANT: Copy this file to '.env' and fill in your real values.
# NEVER commit your '.env' file to version control!

# Flask Core
SECRET_KEY=your_generated_secret_key_here
FLASK_ENV=production

# AI / Neural Engine (Groq Llama 3)
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_key_if_using_gpt

# Database (Future Persistence)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/smarthire
# FIREBASE_API_KEY=your_firebase_key_here

# SMTP / Email Service
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# EMAIL_USER=your_email@gmail.com (Alias for SMTP_EMAIL)
# EMAIL_PASS=your_app_password_here (Alias for SMTP_PASSWORD)

# Admin Security
ADMIN_SECRET_KEY=123456789

# Platform Settings
VERCEL=0
DEBUG=False
